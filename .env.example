# ============================================================
# UNISOLE — environment variables
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# Never commit `.env` — it is already in .gitignore.
# For production (Render), set the same keys in the dashboard's
# "Environment" tab (never store secrets in the repo).
# ============================================================

# ---- Server ----
PORT=5000

# MongoDB Atlas connection string (Database Access -> create user,
# then Connect -> Drivers). Rotate the password regularly and never
# commit this file.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/unisole

# JWT signing secret. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-secret>

# ---- Cloudinary (image uploads) ----
# Cloudinary dashboard -> Settings -> Access keys
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ---- Razorpay (payments) ----
# Razorpay dashboard -> Settings -> API Keys.
# RAZORPAY_KEY_ID is public (used on the client), KEY_SECRET is private.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=<your-key-secret>

# ---- Frontend (Vite) — used by react-frontend/src/config.js ----
# Set in react-frontend/.env or as Render environment variables prefixed
# with VITE_. Razorpay key id / Google client id are public by design.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>
